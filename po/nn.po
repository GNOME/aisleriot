#: data/org.gnome.Aisleriot.desktop.in:2
#: data/org.gnome.Aisleriot.metainfo.xml.in:34
msgid "Aisleriot Solitaire"
msgstr "Aisleriot-kabal"

#: data/org.gnome.Aisleriot.desktop.in:3
#: data/org.gnome.Aisleriot.metainfo.xml.in:35
msgid "Play many different solitaire games"
msgstr "Spel mange ulike kabalar"

#: data/org.gnome.Aisleriot.desktop.in:9
msgid "solitaire;cards;klondike;spider;freecell;patience;"
msgstr "kabal;kort;kortspel;solitaire;"

#: data/org.gnome.Aisleriot.metainfo.xml.in:37
msgid ""
"Aisleriot — also known as sol or solitaire — is a card game application that "
"features over 80 different solitaire-type card games which are designed to "
"play using a mouse, keyboard, or trackpad."
msgstr ""
"Aisleriot – òg kjend som «sol» og «solitaire» – er eit kortspelprogram som "
"inneheld meir enn 80 forskjellige slag kabalar, som kan spelast med mus, "
"tastatur eller styreplate."

#: data/org.gnome.Aisleriot.metainfo.xml.in:59
#: data/org.gnome.Aisleriot.metainfo.xml.in:61
msgid "Aisleriot Developers"
msgstr "Aisleriot-utviklarane"

